# Required — copy to .env and fill in values. Never commit the real .env.
NODE_ENV="development"
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
JWT_SECRET="generate-at-least-32-random-bytes"
JWT_ISSUER="bkk-community-api"
JWT_AUDIENCE="bkk-community-apps"
PORT=8000

# Required for real password-reset delivery. Use a provider's SMTP credentials
# (for example Brevo, Postmark, SendGrid SMTP relay or a Google app password).
SMTP_HOST="smtp.provider.example"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
FROM_EMAIL="BKK Community <noreply@your-verified-domain.example>"

# Required and different from JWT_SECRET.
RESET_CODE_PEPPER="generate-a-second-long-random-secret"

# Comma-separated browser origins. Mobile apps do not send an Origin header.
CORS_ORIGINS="http://localhost:8080"

# Destructive demo seeding is refused unless this is explicitly true.
ALLOW_DEMO_SEED="false"

# Firebase Admin service-account JSON. Configure only in the hosting provider.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
