<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- Production: only HTTPS to bkkcommunity.co.za -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">bkkcommunity.co.za</domain>
    </domain-config>

    <!--
        Development: Allow cleartext to the Android emulator's localhost (10.0.2.2)
        and 127.0.0.1 so the local API server on 10.0.2.2:8000 is reachable.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Debug overrides for system and user-installed CAs -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Base config: trust system CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
