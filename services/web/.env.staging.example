APP_ENV=staging
APP_URL=https://staging.example.invalid
APP_BASE_PATH=
APP_SESSION_NAME=bkk_community_staging_session
APP_TRUST_PROXY=true
APP_VERSION=staging-local

ALLOW_DEMO_MODE=false
ADMIN_IDLE_TIMEOUT_SECONDS=1800
ADMIN_ABSOLUTE_TIMEOUT_SECONDS=28800
CONTACT_RETENTION_DAYS=90

# Use a staging-only MySQL database and staging-only credentials.
DB_HOST=staging-mysql.railway.internal
DB_PORT=3306
DB_NAME=bkk_community_staging
DB_USER=bkk_staging_app
DB_PASSWORD=replace-in-railway

# Use staging-only reset and mail credentials. Do not reuse production secrets.
RESET_CODE_SECRET=replace-in-railway
RESEND_API_KEY=replace-in-railway
MAIL_FROM=staging@updates.bkkcommunity.online
MAIL_FROM_NAME=BKK Community Staging
