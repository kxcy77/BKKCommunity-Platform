APP_ENV=production
APP_URL=https://www.bkkcommunity.online
APP_BASE_PATH=
APP_SESSION_NAME=bkk_community_production_session
APP_TRUST_PROXY=true
# Railway supplies RAILWAY_GIT_COMMIT_SHA automatically for GitHub deployments.
APP_VERSION=

ALLOW_DEMO_MODE=false
ADMIN_IDLE_TIMEOUT_SECONDS=1800
ADMIN_ABSOLUTE_TIMEOUT_SECONDS=28800
CONTACT_RETENTION_DAYS=365

# Reference the private production MySQL service in Railway. Never commit values.
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_NAME=bkk_community
DB_USER=bkk_app
DB_PASSWORD=replace-in-railway

RESET_CODE_SECRET=replace-in-railway
RESEND_API_KEY=replace-in-railway
MAIL_FROM=noreply@updates.bkkcommunity.online
MAIL_FROM_NAME=BKK Community
